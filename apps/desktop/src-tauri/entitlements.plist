<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store sandboxing — required for Store distribution -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Outbound network for app API, generation endpoints, Stripe -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- File access for "Save portrait as..." -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Camera permission disabled (we use file picker, not direct camera capture on desktop) -->
    <!-- <key>com.apple.security.device.camera</key>
    <true/> -->

    <!-- WebView requires JIT compilation -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Required for Tauri WebView -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>

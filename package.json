{
  "name": "pup-portrait",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered dog portrait generator using Nano Banana",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "mobile": "cd apps/mobile && npm start",
    "mobile:web": "cd apps/mobile && npm run web",
    "mobile:ios": "cd apps/mobile && npm run ios",
    "mobile:android": "cd apps/mobile && npm run android",
    "admin": "cd apps/admin && npm run dev",
    "db:migrate": "cd supabase && supabase db push",
    "db:generate": "cd supabase && supabase gen types typescript --local > ../packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "packageManager": "npm@10.2.0",
  "engines": {
    "node": ">=18"
  }
}

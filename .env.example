# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI — Nano Banana 2 (Gemini 3.1 Flash Image)
# 2026-05-19 relaunch: replaced Gemini 2.0 Flash as the default engine.
GOOGLE_AI_API_KEY=your-google-ai-api-key
GOOGLE_AI_MODEL_DEFAULT=gemini-3.1-flash-image-preview

# fal.ai — Flux Kontext Pro (Realism tier upsell)
# 2026-05-19 relaunch: powers the $49.99/yr Premium Annual + Realism tier.
FAL_AI_API_KEY=your-fal-ai-api-key
FAL_AI_MODEL_REALISM=fal-ai/flux-kontext-pro

# Stripe
STRIPE_SECRET_KEY=sk_live_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-publishable-key

# Stripe Price IDs (create in Stripe Dashboard — see 30_Specs/Pricing-Config)
# 2026-05-19 relaunch: prices changed and two new products were added.
STRIPE_PRICE_PACK=price_pack_999_id              # $9.99 one-time, 12-portrait pack from photo upload
STRIPE_PRICE_MONTHLY=price_monthly_599_id        # $5.99 / month
STRIPE_PRICE_YEARLY=price_yearly_2999_id         # $29.99 / year
STRIPE_PRICE_REALISM_YEARLY=price_realism_4999   # $49.99 / year, unlocks Photoreal mode
STRIPE_PRICE_LIFETIME=price_lifetime_4999_id     # $49.99 one-time, forever

# Google AdSense (optional)
GOOGLE_ADSENSE_PUBLISHER_ID=ca-pub-2481111694255269

# OAuth Providers (configure in Supabase Dashboard)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_SECRET=your-apple-client-secret
